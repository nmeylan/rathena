name: rathena-proxy

services:
    haproxy:
        image: "haproxy:lts-alpine"
        container_name: "rathena-haproxy"
        restart: unless-stopped
        ports:
            - "6900:6900"   # login (single, shared by all worlds)
            # >>> WORLD PORTS (generated — do not edit below this line)
        volumes:
            - "./haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg:ro"
        networks:
            - shared

# Joins the login stack's network so it can reach every container by name.
networks:
    shared:
        external: true
        name: rathena-nmey_default
