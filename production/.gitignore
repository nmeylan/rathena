# Prod secrets — never commit real credentials
.env
# per-world env files (generated by new-world.sh; hold the interserver password)
.env.world-*

# GENERATED asset configs (rendered by render-assets.sh from the *-template/
# dirs + env). They hold the DB password / interserver creds — regenerate,
# don't commit. Only the templates are tracked.
asset-login/inter_conf.txt
asset-login/login_conf.txt
asset-world-*/
!asset-world-template/

# Python bytecode from gen-level-tables.py
__pycache__/

# GENERATED HAProxy config (render-haproxy.sh, from the .env.world-* files).
# These are runtime state: which worlds exist differs per deployment, so tracking
# them guarantees local/server divergence and a `git pull` would wipe the
# server's registered worlds. Only the .template files are tracked.
haproxy/haproxy.cfg
haproxy/docker-compose.yml
